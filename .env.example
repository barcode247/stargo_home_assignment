# Copy to .env (git-ignored). Everything is optional: with no key the app runs rules-only.
#
# LLM_PROVIDER: groq | gemini | ollama | none
#   groq   -> https://api.groq.com/openai/v1           (free tier, needs LLM_API_KEY)
#   gemini -> generativelanguage.googleapis.com/openai (free tier, needs LLM_API_KEY)
#   ollama -> http://localhost:11434/v1                (local, no key)
LLM_PROVIDER=
LLM_API_KEY=
# Optional overrides
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20
